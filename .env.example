# Configure these variables in Vercel > Project > Settings > Environment Variables.
# Do not expose TURSO_AUTH_TOKEN or POS_API_KEY in VITE_* variables.
TURSO_DATABASE_URL="libsql://your-database-your-org.turso.io"
TURSO_AUTH_TOKEN="replace-with-your-turso-auth-token"
# Create a long random API access key and enter the same value in POS > Base de datos.
POS_API_KEY="replace-with-a-long-random-secret"
# Optional: production URL used by the Windows desktop build when selecting Turso.
APP_URL="https://integral-six-steel.vercel.app"

# AI provider (optional, existing functionality)
GEMINI_API_KEY=""
