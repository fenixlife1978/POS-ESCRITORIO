{
  "appId": "com.elpiston.pos",
  "productName": "POS El Pistón",
  "directories": {
    "output": "dist-exe"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "package.json"
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      },
      {
        "target": "portable",
        "arch": [
          "x64"
        ]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "artifactName": "POS-El-Piston-Setup-${version}.${ext}"
  },
  "portable": {
    "artifactName": "POS-El-Piston-Portable.${ext}"
  }
}
